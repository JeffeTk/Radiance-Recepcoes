# Copie este arquivo para .env e preencha.

# Chave secreta (obrigatória). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco de dados MySQL / MariaDB (criado com banco/radiance_banco.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=radiance
DB_PASSWORD=
DB_NAME=radiance

# E-mail para enviar o código de verificação.
# Deixe SMTP_HOST vazio em desenvolvimento: o código aparece no terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu e-mail,
#        SMTP_PASSWORD=uma "senha de app" (não a senha normal da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Radiance Recepções e Eventos <radiance.recepcoes@gmail.com>

# Coloque true quando o site estiver no ar com HTTPS
COOKIE_SECURE=false

# 1 = modo de desenvolvimento (python app.py recarrega ao editar e mostra
# erros detalhados). Use 0 sempre que outras pessoas puderem acessar.
FLASK_DEBUG=1

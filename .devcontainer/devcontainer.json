// Configuração do GitHub Codespaces (e do "Dev Containers" do VS Code).
// Ao criar o Codespace, sobe dois containers:
//   app → Python 3.12, onde roda o servidor Flask (back-end + páginas do site)
//   db  → MySQL 8, já com o banco criado por banco/radiance_banco.sql
// Depois instala as dependências, gera o backend/.env e inicia o site na porta 5000.
{
  "name": "Radiance — site + back-end",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  // Só a porta do site fica acessível. O MySQL não é exposto para fora.
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "Site Radiance", "onAutoForward": "openBrowser" }
  },

  // 1x, quando o Codespace é criado: instala as dependências e cria o .env
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Toda vez que você abre o Codespace: espera o banco e inicia o servidor
  "postAttachCommand": "bash .devcontainer/iniciar.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
